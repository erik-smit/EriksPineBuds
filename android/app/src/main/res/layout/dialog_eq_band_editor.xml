<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tv_band_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Edit EQ Band"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <!-- Filter Type -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Filter Type"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginTop="8dp" />

    <Spinner
        android:id="@+id/spinner_filter_type"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:layout_marginTop="4dp" />

    <!-- Frequency -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Frequency"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/tv_frequency_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="1000 Hz"
        android:textSize="16sp"
        android:layout_marginTop="4dp" />

    <com.google.android.material.slider.Slider
        android:id="@+id/slider_frequency"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:valueFrom="0"
        android:valueTo="100"
        android:value="50"
        android:stepSize="1" />

    <!-- Gain -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Gain"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/tv_gain_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0.0 dB"
        android:textSize="16sp"
        android:layout_marginTop="4dp" />

    <com.google.android.material.slider.Slider
        android:id="@+id/slider_gain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:valueFrom="-12.0"
        android:valueTo="12.0"
        android:value="0.0"
        android:stepSize="0.5" />

    <!-- Q Factor -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Q Factor (Bandwidth)"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/tv_q_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="1.0"
        android:textSize="16sp"
        android:layout_marginTop="4dp" />

    <com.google.android.material.slider.Slider
        android:id="@+id/slider_q"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:valueFrom="0.3"
        android:valueTo="10.0"
        android:value="1.0"
        android:stepSize="0.1" />

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="24dp">

        <Button
            android:id="@+id/btn_cancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Cancel"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btn_save"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Save"
            android:layout_marginStart="8dp" />
    </LinearLayout>

</LinearLayout>
